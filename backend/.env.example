# Database URLs (directUrl is required when using connection poolers such as Neon/Supabase)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/farm_management?schema=public
DIRECT_URL=postgresql://USER:PASSWORD@localhost:5432/farm_management?schema=public

# Server configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Authentication & Security
JWT_SECRET=replace-with-a-secure-random-secret-key-in-production
JWT_EXPIRES_IN=1d
# Set to true only in local dev/test to expose reset token in forgot-password response.
# Production must use email/SMS delivery and leave this unset/false.
ALLOW_RESET_TOKEN_IN_RESPONSE=false

# Password-reset email delivery: Resend (preferred) or SMTP fallback.
# Resend: set RESEND_API_KEY=re_... and EMAIL_FROM. No SMTP needed.
RESEND_API_KEY=
EMAIL_FROM=Poultry Management <no-reply@yourdomain.com>
# SMTP fallback via nodemailer (only used when RESEND_API_KEY is unset)
# If SMTP_HOST is unset, emails are logged in dev and skipped in production
# (API still returns the generic success message).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=replace-with-smtp-password
SMTP_FROM=Poultry Management <no-reply@example.com>
# Public frontend URL used to build the reset link, e.g. https://app.example.com
FRONTEND_URL=http://localhost:5173
