# Database URLs (directUrl is required when using connection poolers such as Neon/Supabase)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/farm_management?schema=public
DIRECT_URL=postgresql://USER:PASSWORD@localhost:5432/farm_management?schema=public

# Server configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Authentication & Security
JWT_SECRET=replace-with-a-secure-random-secret-key-in-production
JWT_EXPIRES_IN=7d
