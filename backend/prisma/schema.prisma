generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Enumerated domain values (application-enforced; see migration note below).
// Prisma fields remain String for backward compatibility until a dedicated
// enum-migration is applied. New code should use these values.
enum FlockPurpose {
  BROILER
  LAYER
  BREEDER
  DUAL_PURPOSE
  OTHER
}

enum FlockStatus {
  ACTIVE
  COMPLETED
  SOLD
  SLAUGHTERED
  ARCHIVED
}

enum VaccinationStatus {
  PENDING
  COMPLETED
  MISSED
}

enum DepopulationReason {
  SOLD
  SLAUGHTERED
  CULLED
  TRANSFERRED
  OTHER
}

enum PaymentStatus {
  PAID
  PARTIALLY_PAID
  UNPAID
}

enum InventoryMovementType {
  PURCHASE
  CONSUMPTION
  ADJUSTMENT
  WASTAGE
  RETURN
}

model User {
  id        Int            @id @default(autoincrement())
  email     String         @unique
  password  String
  name      String
  createdAt DateTime       @default(now())
  updatedAt DateTime?      @updatedAt
  houses    PoultryHouse[]
  flocks    Flock[]
  vaccinations Vaccination[]
  expenses  Expense[]
  income    Income[]
  customers Customer[]
  suppliers Supplier[]
  feedTypes FeedType[]
  inventoryMovements InventoryMovement[]
  depopulationEvents DepopulationEvent[]
  dailyRecordCorrections DailyRecordCorrection[]
  eggInventory EggInventory?
  eggMovements EggMovement[]
  eggSales EggSale[]

  @@map("users")
}

model PoultryHouse {
  id             Int             @id @default(autoincrement())
  userId         Int
  name           String
  address        String?
  birdsPlaced    Int
  createdAt      DateTime        @default(now())
  flocks         Flock[]
  dailyRecords   DailyRecord[]
  breeds         Breed[]
  birdConditions BirdCondition[]
  slaughterPlans SlaughterPlan[]
  expenses       Expense[]
  income         Income[]
  inventoryMovements InventoryMovement[]
  eggSales       EggSale[]
  eggMovements   EggMovement[]

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("poultry_houses")
}

model DailyRecord {
  id            Int          @id @default(autoincrement())
  houseId       Int
  flockId       Int?
  date          DateTime
  mortality     Int          @default(0)
  feedUsedKg    Float        @default(0)
  eggsCollected Int          @default(0)
  avgWeightGrams Float?
  feedTypeId    Int?
  createdAt     DateTime     @default(now())

  // A house deletion removes its dependent production history.
  house         PoultryHouse @relation(fields: [houseId], references: [id], onDelete: Cascade)
  flock         Flock?       @relation(fields: [flockId], references: [id], onDelete: SetNull)
  feedType      FeedType?    @relation(fields: [feedTypeId], references: [id], onDelete: SetNull)
  inventoryMovements InventoryMovement[]
  eggMovements EggMovement[]
  corrections   DailyRecordCorrection[]

  // The API treats one record per house and date as the daily grain.
  @@unique([houseId, date])
  @@index([flockId])
  @@index([feedTypeId])
  @@map("daily_records")
}

// Append-only corrections for immutable DailyRecords (outside the
// correction window). The original row is never modified; reporting sums
// raw values + adjustments. See correction.service.js.
model DailyRecordCorrection {
  id             Int      @id @default(autoincrement())
  userId         Int
  dailyRecordId  Int
  field          String   // MORTALITY, EGGS
  previousValue  Float
  correctedValue Float
  adjustment     Float    // correctedValue - previousValue
  reason         String
  createdAt      DateTime @default(now())

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyRecord  DailyRecord @relation(fields: [dailyRecordId], references: [id], onDelete: Cascade)
  eggMovements EggMovement[]

  @@index([dailyRecordId])
  @@index([userId])
  @@map("daily_record_corrections")
}

model Breed {
  id             Int             @id @default(autoincrement())
  houseId        Int
  name           String
  description    String?
  numberOfBirds  Int
  dateAdded      DateTime        @default(now())
  createdAt      DateTime        @default(now())

  house          PoultryHouse    @relation(fields: [houseId], references: [id], onDelete: Cascade)
  flocks         Flock[]
  birdConditions BirdCondition[]
  slaughterPlans SlaughterPlan[]
  expenses       Expense[]
  income         Income[]

  @@index([houseId])
  @@map("breeds")
}

model BirdCondition {
  id               Int          @id @default(autoincrement())
  houseId          Int
  flockId          Int?
  breedId          Int?
  healthy          Int          @default(0)
  sick             Int          @default(0)
  weak             Int          @default(0)
  underObservation Int          @default(0)
  notes            String?
  recordDate       DateTime
  createdAt        DateTime     @default(now())

  house            PoultryHouse @relation(fields: [houseId], references: [id], onDelete: Cascade)
  flock            Flock?       @relation(fields: [flockId], references: [id], onDelete: SetNull)
  breed            Breed?       @relation(fields: [breedId], references: [id], onDelete: SetNull)

  @@index([houseId])
  @@index([flockId])
  @@map("bird_conditions")
}

model SlaughterPlan {
  id                    Int          @id @default(autoincrement())
  houseId               Int
  flockId               Int?
  breedId               Int?
  numberOfBirds         Int
  placementDate         DateTime
  expectedSlaughterDate DateTime
  status                String       @default("Upcoming")
  notes                 String?
  createdAt             DateTime     @default(now())

  house                 PoultryHouse @relation(fields: [houseId], references: [id], onDelete: Cascade)
  flock                 Flock?       @relation(fields: [flockId], references: [id], onDelete: SetNull)
  breed                 Breed?       @relation(fields: [breedId], references: [id], onDelete: SetNull)

  @@index([houseId])
  @@index([flockId])
  @@map("slaughter_plans")
}

model Customer {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sales     Income[]
  eggSales  EggSale[]

  @@index([userId])
  @@map("customers")
}

model Supplier {
  id        Int       @id @default(autoincrement())
  userId    Int
  name      String
  phone     String?
  email     String?
  address   String?
  category  String?
  notes     String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses  Expense[]

  @@index([userId])
  @@map("suppliers")
}

model Expense {
  id            Int           @id @default(autoincrement())
  userId        Int
  houseId       Int?
  flockId       Int?
  breedId       Int?
  supplierId    Int?
  feedTypeId    Int?
  category      String
  amount        Decimal       @db.Decimal(12, 2)
  date          DateTime
  description   String?
  quantity      Decimal?      @db.Decimal(12, 2)
  unit          String?
  unitPrice     Decimal?      @db.Decimal(12, 2)
  amountPaid    Decimal?      @default(0) @db.Decimal(12, 2)
  amountDue     Decimal?      @default(0) @db.Decimal(12, 2)
  paymentStatus String?       @default("PAID")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  house         PoultryHouse? @relation(fields: [houseId], references: [id], onDelete: SetNull)
  flock         Flock?        @relation(fields: [flockId], references: [id], onDelete: SetNull)
  breed         Breed?        @relation(fields: [breedId], references: [id], onDelete: SetNull)
  supplier      Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  feedType      FeedType?     @relation(fields: [feedTypeId], references: [id], onDelete: SetNull)
  inventoryMovements InventoryMovement[]

  @@index([userId, date])
  @@index([houseId])
  @@index([flockId])
  @@index([supplierId])
  @@index([feedTypeId])
  @@map("expenses")
}

model Income {
  id            Int           @id @default(autoincrement())
  userId        Int
  houseId       Int?
  flockId       Int?
  breedId       Int?
  customerId    Int?
  category      String
  amount        Decimal       @db.Decimal(12, 2)
  date          DateTime
  description   String?
  quantity      Decimal?      @db.Decimal(12, 2)
  unit          String?
  unitPrice     Decimal?      @db.Decimal(12, 2)
  amountPaid    Decimal?      @default(0) @db.Decimal(12, 2)
  amountDue     Decimal?      @default(0) @db.Decimal(12, 2)
  paymentStatus String?       @default("PAID")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  house         PoultryHouse? @relation(fields: [houseId], references: [id], onDelete: SetNull)
  flock         Flock?        @relation(fields: [flockId], references: [id], onDelete: SetNull)
  breed         Breed?        @relation(fields: [breedId], references: [id], onDelete: SetNull)
  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  depopulationEvents DepopulationEvent[]
  eggSales EggSale[]

  @@index([userId, date])
  @@index([houseId])
  @@index([flockId])
  @@index([customerId])
  @@map("income")
}

model FeedType {
  id           Int                 @id @default(autoincrement())
  userId       Int
  name         String
  category     String              @default("FEED")
  description  String?
  unit         String              @default("kg")
  bagWeightKg  Float?              @default(50)
  minimumStock Decimal             @default(0) @db.Decimal(12, 2)
  currentStock Decimal             @default(0) @db.Decimal(12, 2)
  unitCost     Decimal             @default(0) @db.Decimal(12, 2)
  active       Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  movements    InventoryMovement[]
  expenses     Expense[]
  dailyRecords DailyRecord[]

  @@index([userId])
  @@index([userId, category])
  @@map("feed_types")
}

model InventoryMovement {
  id            Int           @id @default(autoincrement())
  userId        Int
  feedTypeId    Int
  houseId       Int?
  dailyRecordId Int?
  expenseId     Int?
  type          String        // PURCHASE, CONSUMPTION, ADJUSTMENT, WASTAGE, RETURN
  quantity      Decimal       @db.Decimal(12, 2)
  unit          String
  unitCost      Decimal?      @db.Decimal(12, 2)
  totalCost     Decimal?      @db.Decimal(12, 2)
  balanceAfter  Decimal       @db.Decimal(12, 2)
  date          DateTime
  reason        String?
  createdAt     DateTime      @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedType      FeedType      @relation(fields: [feedTypeId], references: [id], onDelete: Cascade)
  house         PoultryHouse? @relation(fields: [houseId], references: [id], onDelete: SetNull)
  dailyRecord   DailyRecord?  @relation(fields: [dailyRecordId], references: [id], onDelete: SetNull)
  expense       Expense?      @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([feedTypeId])
  @@index([houseId])
  @@index([type])
  @@map("inventory_movements")
}

model Flock {
  id                  Int             @id @default(autoincrement())
  userId              Int
  houseId             Int
  breedId             Int?
  name                String
  batchNumber         String?
  purpose             String          @default("BROILER") // BROILER, LAYER, BREEDER, DUAL_PURPOSE, OTHER
  birdsPlaced         Int
  currentBirds        Int
  placementDate       DateTime
  expectedMarketDate  DateTime?
  targetWeightKg      Float?
  status              String          @default("ACTIVE") // ACTIVE, COMPLETED, SOLD, SLAUGHTERED, ARCHIVED
  notes               String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  house               PoultryHouse    @relation(fields: [houseId], references: [id], onDelete: Cascade)
  breed               Breed?          @relation(fields: [breedId], references: [id], onDelete: SetNull)
  dailyRecords        DailyRecord[]
  birdConditions      BirdCondition[]
  slaughterPlans      SlaughterPlan[]
  vaccinations        Vaccination[]
  expenses            Expense[]
  income              Income[]
  depopulationEvents  DepopulationEvent[]
  eggSales            EggSale[]
  eggMovements        EggMovement[]

  @@index([userId])
  @@index([houseId])
  @@index([status])
  @@map("flocks")
}

model Vaccination {
  id               Int          @id @default(autoincrement())
  userId           Int
  flockId          Int
  vaccineName      String
  disease          String?
  targetAgeDays    Int?
  scheduledDate    DateTime
  administeredDate DateTime?
  status           String       @default("PENDING") // PENDING, COMPLETED, MISSED
  dosage           String?
  administeredBy   String?
  cost             Decimal?     @default(0) @db.Decimal(12, 2)
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  flock            Flock        @relation(fields: [flockId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([flockId])
  @@index([status])
  @@map("vaccinations")
}

model DepopulationEvent {
  id          Int       @id @default(autoincrement())
  userId      Int
  flockId     Int
  quantity    Int
  reason      String    // SOLD, SLAUGHTERED, CULLED, TRANSFERRED, OTHER
  date        DateTime
  notes       String?
  incomeId    Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  flock       Flock     @relation(fields: [flockId], references: [id], onDelete: Cascade)
  income      Income?   @relation(fields: [incomeId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([flockId])
  @@index([incomeId])
  @@map("depopulation_events")
}

// Phase 4.2 — Egg inventory (pieces). EggInventory.currentStock is the
// authoritative cached stock; EggMovement is the append-only audit ledger
// with a per-row balanceAfter snapshot (same pattern as feed inventory).
// One row per user: egg stock is shared farm stock, like feed stock.
model EggInventory {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique
  currentStock Int      @default(0)
  unit         String   @default("pieces")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("egg_inventory")
}

// Phase 4.2 — Egg sale (physical removal, mirrors DepopulationEvent).
// Quantity is a count of eggs/pieces; unitPrice is GMD price per egg.
// The linked Income (category "Egg sales") is the financial record.
model EggSale {
  id          Int       @id @default(autoincrement())
  userId      Int
  houseId     Int?
  flockId     Int?
  customerId  Int?
  incomeId    Int?
  quantity    Int
  unitPrice   Decimal?  @db.Decimal(12, 2)
  date        DateTime
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  house       PoultryHouse? @relation(fields: [houseId], references: [id], onDelete: SetNull)
  flock       Flock?        @relation(fields: [flockId], references: [id], onDelete: SetNull)
  customer    Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  income      Income?       @relation(fields: [incomeId], references: [id], onDelete: SetNull)
  movements   EggMovement[]

  @@index([userId])
  @@index([incomeId])
  @@map("egg_sales")
}

model EggMovement {
  id            Int       @id @default(autoincrement())
  userId        Int
  houseId       Int?
  flockId       Int?
  dailyRecordId Int?
  eggSaleId     Int?
  correctionId  Int?      @unique
  type          String    // PRODUCTION, SALE, ADJUSTMENT, WASTAGE, RETURN, CORRECTION
  quantity      Int       // signed: +production/return, -sale/wastage
  unit          String    @default("pieces")
  balanceAfter  Int
  date          DateTime
  reason        String?
  createdAt     DateTime  @default(now())

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  house         PoultryHouse? @relation(fields: [houseId], references: [id], onDelete: SetNull)
  flock         Flock?        @relation(fields: [flockId], references: [id], onDelete: SetNull)
  dailyRecord   DailyRecord?  @relation(fields: [dailyRecordId], references: [id], onDelete: SetNull)
  eggSale       EggSale?      @relation(fields: [eggSaleId], references: [id], onDelete: Cascade)
  correction    DailyRecordCorrection? @relation(fields: [correctionId], references: [id], onDelete: Cascade)

  // Duplicate protection: exactly one PRODUCTION movement per daily
  // record, one SALE movement per egg sale, and one CORRECTION movement
  // per correction, enforced by the database.
  @@unique([dailyRecordId, type])
  @@unique([eggSaleId])
  @@index([userId])
  @@index([type])
  @@map("egg_movements")
}